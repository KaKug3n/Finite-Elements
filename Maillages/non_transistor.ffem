// fichier rect1.ffem (FreeFem++)
// =================================================
// maillage structuré d’un transistor:
// =================================================

//Read mesh

//maillage non-struct du rectangle ]0,4[x]0,2[
real L=4.0, l=2.0;
int Neu=2, Dir=1;

//Sommets caractéritique des bords:
real x0=0.0, y0=0.0;
real x1=0.5, y1=0.0;
real x2=0.7, y2=0.2;
real x3=1.5, y3=0.2;
real x4=1.7, y4=0.0;
real x5=2.0, y5=0.0;
real x6=2.0, y6=1.0;
real x7=0.0, y7=1.0;
real x8=x0, y8=y0;

//Construction du mesh
border a (t=0,1){x=x0+t*(x1-x0);y=y0+t*(y1-y0);label=2;};
border b (t=0,1){x=x1+t*(x2-x1);y=y1+t*(y2-y1);label=2;};
border c (t=0,1){x=x2+t*(x3-x2);y=y2+t*(y3-y2);label=2;};
border d (t=0,1){x=x3+t*(x4-x3);y=y3+t*(y4-y3);label=2;};
border e (t=0,1){x=x4+t*(x5-x4);y=y4+t*(y5-y4);label=2;};
border f (t=0,1){x=x5+t*(x6-x5);y=y5+t*(y6-y5);label=2;};
border g (t=0,1){x=x6+t*(x7-x6);y=y6+t*(y7-y6);label=2;};
border h (t=0,1){x=x7+t*(x8-x7);y=y7+t*(y8-y7);label=2;};

//mesh
mesh Th=buildmesh(
     a(10)
    +b(5)
    +c(5)
    +d(5)
    +e(5)
    +f(10)
    +g(5)
    +h(5)
);

//Affichage
plot(Th);

//Save
savemesh(Th, "rectangle_non_struct.msh");