// fichier house1 (FreeFem++)
// =================================================
// maillage structuré d’une maison simple:
// =================================================

//Read mesh

//Cond
int Neu=2, Dir=1;
real L=12.0, h=3.0;

//Sommets caractéritique des bords:
//r0
real x0=0.0, y0=0.0;
real x1=L, y1=0.0;
real x2=L, y2=h;
real x3=0.0, y3=h;
real x4=x0, y4=y0;

//r1
real x5=L/2, y5=2*h;


//Construction du mesh
border a (t=0,1){x=x0+t*(x1-x0);y=y0+t*(y1-y0);label=2;};
border b (t=0,1){x=x1+t*(x2-x1);y=y1+t*(y2-y1);label=2;};
border c (t=0,1){x=x2+t*(x3-x2);y=y2+t*(y3-y2);label=2;};
border d (t=0,1){x=x3+t*(x4-x3);y=y3+t*(y4-y3);label=2;};

border e (t=0,1){x=x2+t*(x5-x2);y=y2+t*(y5-y2);label=2;};
border f (t=0,1){x=x5+t*(x3-x5);y=y5+t*(y3-y5);label=2;};



//mesh
mesh Th=buildmesh(
     a(20)
    +b(20)
    +c(20)
    +d(20)

    +e(20)
    +f(20)
);

//Affichage
plot(Th);

//Save
savemesh(Th, "houseBase.msh");